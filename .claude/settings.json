{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/fast-check.sh)",
      "Bash(./scripts/smoke-test.sh)",
      "Bash(./mvnw -q -pl *)",
      "Bash(./mvnw -q -B -pl *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Skill(verify)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-build-cmd.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-java.sh"
          }
        ]
      }
    ]
  }
}
