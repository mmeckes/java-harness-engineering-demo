{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/fast-check.sh)",
      "Bash(./scripts/smoke-test.sh)",
      "Bash(./mvnw -q -pl *)",
      "Bash(./mvnw -q -B -pl *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Skill(verify)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "extraKnownMarketplaces": {
    "mmeckes-harness-demo": {
      "source": {
        "source": "github",
        "repo": "mmeckes/java-harness-engineering-demo"
      }
    }
  },
  "enabledPlugins": {
    "java-harness@mmeckes-harness-demo": true
  }
}
